generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?   // null si el usuario entró solo con Google
  googleId      String?   @unique
  onboarded     Boolean   @default(false)
  // Token que identifica al usuario en la dirección de reenvío de correos
  // del banco (ej. ingest+<token>@...). Se genera al pedir la dirección.
  ingestToken   String?   @unique
  createdAt     DateTime  @default(now())

  profile       Profile?
  fixedExpenses FixedExpense[]
  incomes       Income[]
  expenses      Expense[]
  cards         CreditCard[]
  bankLinks     BankLink[]
  gmailLink     GmailLink?
  pending       PendingMovement[]
  budgets       Budget[]
  goals         SavingsGoal[]
}

// Datos recolectados en el onboarding
model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlySalary Decimal @db.Decimal(12, 2)
  childrenCount Int     @default(0)
  householdType String  @default("individual") // individual | familia
  currency      String  @default("CLP")
}

// Sueldo, dividendos, arriendos, etc.
model Income {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // "Sueldo", "Dividendo", "Arriendo"
  amount    Decimal  @db.Decimal(12, 2)
  recurring Boolean  @default(true) // mensual
  externalId String? @unique // id del correo/mensaje, evita duplicados
  date      DateTime @default(now())
}

// Gastos fijos mensuales: dividendo hipotecario, colegio, cuentas
model FixedExpense {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label    String
  amount   Decimal @db.Decimal(12, 2)
  category String  @default("otros")
  dueDay   Int?    // día del mes en que se paga
}

// Gastos variables: manuales, por webhook bancario o correo
model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("otros") // supermercado, transporte, salud, ocio...
  source      String   @default("manual") // manual | fintoc | email
  cardId      String?
  card        CreditCard? @relation(fields: [cardId], references: [id])
  externalId  String?  @unique // id del movimiento en Fintoc, evita duplicados
  date        DateTime @default(now())
  // Si es un ahorro, la meta a la que se suma. Si la meta se borra el gasto
  // queda como ahorro sin meta, en vez de desaparecer del historial.
  goalId      String?
  goal        SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// PCI-DSS: NUNCA se guarda el número completo ni CVV
model CreditCard {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank        String    // "Banco de Chile"
  brand       String    // Visa / Mastercard
  last4       String
  creditLimit Decimal?  @db.Decimal(12, 2)
  billingDay  Int?
  expenses    Expense[]
}

// Conexión con banco vía agregador (Fintoc)
model BankLink {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("fintoc")
  institution  String   // cl_banco_de_chile, cl_banco_santander...
  linkToken    String   // token de link entregado por Fintoc (guardar cifrado en prod)
  accountId    String?
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
}

/// Conexión de solo lectura a Gmail. Guarda el refresh token cifrado y la lista
/// de remitentes a vigilar, para no leer más correo del estrictamente necesario.
model GmailLink {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email          String   // dirección de Gmail conectada
  refreshToken   String   // cifrado con AES-256-GCM, nunca en texto plano
  watchedSenders String[] // dominios/correos del banco a vigilar
  syncFrom       DateTime? // solo se miran correos posteriores a esta marca
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
}

/// Movimiento detectado en un correo que espera confirmación del usuario.
/// No toca el saldo hasta que se aprueba; al rechazarlo queda registrado para
/// no volver a proponerlo si el mismo correo se vuelve a leer.
model PendingMovement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId  String   @unique // gmail:<id> o email:<messageId>
  type        String   // expense | income
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("otros")
  bank        String?
  status      String   @default("pending") // pending | approved | rejected
  date        DateTime
  createdAt   DateTime @default(now())

  @@index([userId, status])
}

/// Tope mensual de gasto variable para una categoría. Uno por categoría.
model Budget {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  amount   Decimal @db.Decimal(12, 2)

  @@unique([userId, category])
}

/// Meta de ahorro. Lo ahorrado se registra con aportes y no toca el saldo
/// disponible: la plata sigue en la cuenta hasta que se use.
model SavingsGoal {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  target    Decimal   @db.Decimal(12, 2)
  saved     Decimal   @default(0) @db.Decimal(12, 2)
  deadline  DateTime?
  createdAt DateTime  @default(now())
  expenses  Expense[] // gastos de categoría "ahorro" que aportan a esta meta
}
