generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?   // null si el usuario entró solo con Google
  googleId      String?   @unique
  onboarded     Boolean   @default(false)
  // Token que identifica al usuario en la dirección de reenvío de correos
  // del banco (ej. ingest+<token>@...). Se genera al pedir la dirección.
  ingestToken   String?   @unique
  createdAt     DateTime  @default(now())

  profile       Profile?
  fixedExpenses FixedExpense[]
  incomes       Income[]
  expenses      Expense[]
  cards         CreditCard[]
  bankLinks     BankLink[]
}

// Datos recolectados en el onboarding
model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlySalary Decimal @db.Decimal(12, 2)
  childrenCount Int     @default(0)
  householdType String  @default("individual") // individual | familia
  currency      String  @default("CLP")
}

// Sueldo, dividendos, arriendos, etc.
model Income {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   // "Sueldo", "Dividendo", "Arriendo"
  amount    Decimal  @db.Decimal(12, 2)
  recurring Boolean  @default(true) // mensual
  externalId String? @unique // id del correo/mensaje, evita duplicados
  date      DateTime @default(now())
}

// Gastos fijos mensuales: dividendo hipotecario, colegio, cuentas
model FixedExpense {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label    String
  amount   Decimal @db.Decimal(12, 2)
  category String  @default("otros")
  dueDay   Int?    // día del mes en que se paga
}

// Gastos variables: manuales, por webhook bancario o correo
model Expense {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("otros") // supermercado, transporte, salud, ocio...
  source      String   @default("manual") // manual | fintoc | email
  cardId      String?
  card        CreditCard? @relation(fields: [cardId], references: [id])
  externalId  String?  @unique // id del movimiento en Fintoc, evita duplicados
  date        DateTime @default(now())

  @@index([userId, date])
}

// PCI-DSS: NUNCA se guarda el número completo ni CVV
model CreditCard {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank        String    // "Banco de Chile"
  brand       String    // Visa / Mastercard
  last4       String
  creditLimit Decimal?  @db.Decimal(12, 2)
  billingDay  Int?
  expenses    Expense[]
}

// Conexión con banco vía agregador (Fintoc)
model BankLink {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   @default("fintoc")
  institution  String   // cl_banco_de_chile, cl_banco_santander...
  linkToken    String   // token de link entregado por Fintoc (guardar cifrado en prod)
  accountId    String?
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
}
