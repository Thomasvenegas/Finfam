# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finfam"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES="7d"

# Google OAuth (https://console.cloud.google.com -> Credentials -> OAuth Client ID tipo Web)
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"

# Fintoc (https://fintoc.com) - agregador open banking Chile, soporta Banco de Chile
FINTOC_SECRET_KEY="sk_test_xxx"
FINTOC_WEBHOOK_SECRET="whsec_xxx"

PORT=3000
FRONTEND_URL="http://localhost:4200"

# --- Ingesta de correos del banco (reenvío desde Gmail) ---
# Dirección base del servicio de inbound parse (Postmark, CloudMailin, SendGrid).
# A cada usuario se le entrega esta dirección con su token: base+<token>@dominio
INGEST_EMAIL_BASE="finfam@inbound.postmarkapp.com"
# Secreto que debe enviar el proveedor en el header x-ingest-key (o ?key=)
EMAIL_INGEST_SECRET="cambia-esto-por-un-secreto-largo"

# --- Lectura directa de Gmail (OAuth) ---
# Credenciales del proyecto en Google Cloud Console (tipo "Aplicación web").
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"
# Debe coincidir exactamente con el "Authorized redirect URI" configurado en Google
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"
# Llave de 32 bytes en hex para cifrar el refresh token: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="genera-con-openssl-rand-hex-32"
